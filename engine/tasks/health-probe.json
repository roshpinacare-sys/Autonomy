{
  "description": "liveness: public chain RPC head block + this repo git tip (read-only)",
  "timeoutSec": 60,
  "commands": [
    "node -e 'fetch(\"https://api.steemit.com\",{method:\"POST\",headers:{\"content-type\":\"application/json\"},body:JSON.stringify({jsonrpc:\"2.0\",method:\"condenser_api.get_dynamic_global_properties\",params:[],id:1})}).then(r=>r.json()).then(j=>console.log(\"chain head_block:\",j.result.head_block_number,\"time:\",j.result.time)).catch(e=>{console.error(e);process.exit(1)})'",
    "git log --oneline -3"
  ]
}
